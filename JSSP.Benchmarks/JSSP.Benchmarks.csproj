<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- BenchmarkDotNet must run in Release mode. This project should never be run in Debug. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JSSP.Core\JSSP.Core.csproj" />
    <ProjectReference Include="..\JSSP.Algorithms\JSSP.Algorithms.csproj" />
    <ProjectReference Include="..\JSSP.IO\JSSP.IO.csproj" />
  </ItemGroup>

</Project>
